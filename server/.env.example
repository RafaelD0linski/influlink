# Copie para .env e preencha. NUNCA commite o .env.
PORT=3000
# Origem do front-end (CORS)
FRONTEND_URL=http://localhost:5173
# URL pública deste backend (use ngrok/cloudflared em dev) — o Mercado Pago chama o webhook aqui
PUBLIC_URL=https://seu-tunel.ngrok.app

# Credenciais de TESTE do painel Mercado Pago Developers (começam com TEST-)
MP_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxxxxxxxxx
# Chave secreta do webhook (painel > Suas integrações > Webhooks)
MP_WEBHOOK_SECRET=

# Comissão da plataforma (9%)
PLATFORM_FEE_PERCENT=9
