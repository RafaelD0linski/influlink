# Copie para .env e preencha. NUNCA commite o .env (já está no .gitignore).
# Credenciais: https://www.mercadopago.com.br/developers/panel/app  ->  sua aplicação  ->  Credenciais
# Use as credenciais de TESTE (TEST-...) até validar tudo; troque por APP_USR-... só em produção.

NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
# URL pública deste backend (em dev use ngrok/cloudflared). O Mercado Pago chama o webhook aqui.
PUBLIC_URL=

# --- Credenciais Mercado Pago ---
# Public Key: segura para o navegador (tokenização do cartão)
MP_PUBLIC_KEY=
# Access Token: SECRETO — só no servidor
MP_ACCESS_TOKEN=
# Client ID / Client Secret: SECRETOS — só para OAuth do modelo Marketplace (split com divulgadores). Preencha os dois ou nenhum.
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Assinatura secreta do webhook (Webhooks > Configurar notificações). Obrigatória em produção.
MP_WEBHOOK_SECRET=

# Comissão da plataforma (%)
PLATFORM_FEE_PERCENT=9
